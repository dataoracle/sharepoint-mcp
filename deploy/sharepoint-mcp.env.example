# Non-secret settings for sharepoint-mcp. Installed as /etc/sharepoint-mcp/sharepoint-mcp.env
# The client secret, MCP token, vault key and Microsoft refresh token are NOT
# here: the first three are TPM-sealed credentials (seal-credential.sh), the
# refresh token is in the encrypted vault (see README).
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Must exactly match a redirect URI registered on the app under the "Web"
# platform (including any port or path), e.g. http://localhost:8400/callback
#MS_REDIRECT_URI=http://localhost

# Optional
#ENABLE_WRITE_TOOLS=true      # false = read-only: no upload/create/move/copy/update tools
#ENABLE_DELETE_TOOLS=false    # true = also register delete_item / delete_list_item (recycle bin)
#KEEPALIVE_HOURS=12           # background refresh so the sign-in doesn't age out; 0 = off
#MAX_READ_CHARS=20000         # default page size of read_file / read_page text (chars)
#MAX_DOWNLOAD_MB=50           # largest file read_file will download
#MAX_UPLOAD_MB=50             # largest file write_file will accept
